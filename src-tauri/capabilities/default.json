{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read",
    "fs:allow-exists",
    "fs:scope-appdata-recursive",
    "fs:scope-home-recursive",
    "fs:scope-resource-recursive"
  ]
}
